{
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "moonops-video": "off",
    "stella-cast": "off",
    "writeup": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/.claude/bin/git-add-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking git add safety..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/.claude/bin/site-link-check.sh",
            "timeout": 30,
            "statusMessage": "Checking site links..."
          },
          {
            "type": "command",
            "command": "/Users/you/.claude/bin/em-dash-check.sh",
            "timeout": 15,
            "statusMessage": "Checking public copy for em dashes..."
          },
          {
            "type": "command",
            "command": "/Users/you/.claude/bin/frontmatter-check.sh",
            "timeout": 15,
            "statusMessage": "Validating skill frontmatter..."
          },
          {
            "type": "command",
            "command": "/Users/you/.claude/bin/backup-after-asset.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/.claude/bin/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/you/.claude/bin/session-end-capture.sh",
            "timeout": 20,
            "statusMessage": "Capturing session for self-heal..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "stripe@claude-plugins-official": true,
    "taste-skill@taste-skill": true,
    "impeccable@impeccable": true,
    "small-business@inline": false,
    "design@inline": false,
    "adspirer-ads-agent@inline": false,
    "postiz@inline": false,
    "marketing@inline": false,
    "sales@inline": false,
    "product-management@inline": false,
    "legal@inline": false,
    "fastly-agent-toolkit@inline": false,
    "monday-com@inline": false,
    "product-tracking-skills@inline": false,
    "cowork-plugin-management@inline": false,
    "engineering@inline": false,
    "pdf-viewer@inline": false,
    "plugin_01AYHYqVLaZRH2Vi6aHgDwEw@inline": false
  },
  "extraKnownMarketplaces": {
    "taste-skill": {
      "source": {
        "source": "github",
        "repo": "leonxlnx/taste-skill"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
